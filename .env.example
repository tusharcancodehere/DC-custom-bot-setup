# ==============================================================================
# DC-CUSTOM-BOT-SETUP CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file or expose tokens in public repositories.
# ==============================================================================

# Required Discord Bot Credentials
DISCORD_TOKEN="your_discord_bot_token"
APPLICATION_ID="your_application_id_here"
SERVER_ID="your_server_id_here"

# Optional Database Configuration (PostgreSQL + asyncpg)
# Required only if persistent storage or database models are enabled.
# The bot runs with in-memory state if this variable is omitted.
DATABASE_URL="postgresql+asyncpg://username:password@localhost:5432/dc_custom_bot"

# Optional AI Features (for /ask command)
OPENAI_API_KEY="your_openai_api_key"
GEMINI_API_KEY="your_gemini_api_key"