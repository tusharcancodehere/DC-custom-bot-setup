# ==============================================================================
# DC-CUSTOM-BOT-SETUP CONFIGURATION TEMPLATE
# Copy this file to .env or .env.local and fill in your actual values.
# NEVER commit your actual .env or .env.local file or expose tokens in public repositories.
# ==============================================================================

# Required Discord Bot Credentials
DISCORD_TOKEN=
APPLICATION_ID=

# Optional Server / Guild ID (for testing guild-scoped instant command registration)
SERVER_ID=

# Web Service Port (Render Web Service health check server; defaults to 10000)
PORT=10000

# Optional Database Configuration
# PostgreSQL is recommended for production and multi-container deployments.
# When DATABASE_URL is left empty or unset, SQLite is used automatically (sqlite+aiosqlite:///data/bot.db).
# Example PostgreSQL: postgresql+asyncpg://user:password@host:5432/database
DATABASE_URL=

# Optional AI Features (for /ask command)
OPENAI_API_KEY=
GEMINI_API_KEY=